# WebServer 网络和运行
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
# 可写入目录和 Stage2 真实模型目录
LOG_DIR=logs
DATA_DIR=data
OUTPUT_DIR=output
LIANTE_TRAIN_DATA_DIR=train_data/data_v5/split_by_channel
LIANTE_MODEL_DIR=saved_models
# Stage2 自动识别输入文件夹；多个目录用分号分隔
STAGE2_INPUT_DIRS=data/stage2_input
# MES 可选择这些根目录下的任意目录；默认输入根目录也在允许范围内
STAGE2_ALLOWED_DIRS=
STAGE2_SOURCE_MAX_EVENTS=20000
STAGE2_SOURCE_RETENTION_DAYS=30
STAGE2_SCAN_MAX_ENTRIES=10000
STAGE2_FILE_STABLE_SECONDS=2
STAGE2_AUTOML_MODEL_DIR=saved_models
# Stage1 / Stage3 真实模型文件及 Python 模块:类适配器；空值表示未配置
STAGE1_MODEL_PATH=
STAGE1_ADAPTER=
STAGE3_MODEL_PATH=
STAGE3_ADAPTER=
STAGE3_MIN_CONFIDENCE=0.8
QUALIFICATION_MAX_AGE_HOURS=168
# 可选元数据和上传限制（字节）
DATABASE_URL=
MAX_UPLOAD_SIZE=20971520
AOI_MAX_STREAMS=4
AOI_QUEUE_CAPACITY=8
AOI_MAX_FRAME_BYTES=2097152
AOI_IDLE_TIMEOUT_SECONDS=300
AOI_MAX_PIXELS=20000000
AOI_RETENTION_DAYS=30
AOI_MAX_JOURNAL_BYTES=21474836480
ALERT_AOI_QUEUE_AGE_SECONDS=5
ALERT_INFERENCE_QUEUE_AGE_SECONDS=30
ALERT_AOI_REJECTION_RATE=0.1
ALERT_AOI_FRAME_MS=1000
STAGE2_WORKERS=1
STAGE3_WORKERS=1
STAGE2_WAITING=4
STAGE3_WAITING=4
TRAINING_WAITING=2
MAX_TRAINING_WORK=200000
MAX_BATCH_PREDICTIONS=100000
MAX_BATCH_RESULT_BYTES=16777216
PREDICTION_CHUNK_ROWS=1024
MAX_SYNC_PREDICTIONS=5000
MAX_PREDICTION_FILE_BYTES=33554432
# 分号分隔的允许读取目录；生产环境应设置为独立的数据目录
PREDICTION_ALLOWED_DIRS=
AOI_ALLOWED_DIRS=
# 三类凭据只通过部署环境注入，不要提交真实值
LIANTE_ADMIN_TOKEN=
LIANTE_OPERATOR_TOKEN=
LIANTE_DEVICE_TOKEN=
# 生产设备建议按 source_id 配置独立密钥，例如 {"CAM-1":"..."}
LIANTE_DEVICE_TOKENS={}
LIANTE_ALLOWED_ORIGINS=
INFERENCE_RESOURCE_SLOTS=1
INFERENCE_RESOURCE_WAIT_SECONDS=30
INFERENCE_QUEUE_WAIT_SECONDS=120
INFERENCE_JOB_TIMEOUT_SECONDS=600
AOI_FRAME_TIMEOUT_SECONDS=30
WEB_TRAIN_DEVICE=cpu
MODEL_VERSION=artifact
RECIPE_VERSION=unconfigured
APP_ENV=development
AOI_VIEW_TYPES=["UNSPECIFIED"]
AOI_REQUIRED_VIEWS=["UNSPECIFIED"]
DISK_WARNING_FREE_RATIO=0.10
DISK_CRITICAL_FREE_RATIO=0.03
DISK_WARNING_FREE_BYTES=2147483648
DISK_CRITICAL_FREE_BYTES=536870912
